# Шаблон конфігурації без секретів. Копіювати до config/disk-health-audit.env і chmod 600.
# Для точного відновлення чинних значень використайте ЗАШИФРОВАНИЙ приватний snapshot.
PROJECT_ROOT=/opt/forprint-utils/disk-health-audit
LOGS_DIR=/opt/forprint-utils/disk-health-audit/logs
POLL_SEC=60
STAGGER_SEC=5
AUTO_INSTALL=no
MAX_WAIT_MINUTES=0
SELFTEST_START_RETRIES=3
SELFTEST_START_RETRY_DELAY=5
RUNS_CLEANUP_ENABLED=yes
RUNS_RETENTION_DAYS=180
TELEGRAM_ENABLED=no
TELEGRAM_SEND_DOCUMENT=yes
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_DISABLE_NOTIFICATION=true
